# Copy to .env and fill in (never commit .env)

COSMOS_ENDPOINT=https://YOUR_ACCOUNT.documents.azure.com:443/
COSMOS_KEY=YOUR_PRIMARY_KEY
COSMOS_DATABASE=bd-budgets

# Ask Buddy — set these on Static Web App "bd-budgets" Application settings.
# Foundry project endpoint is supported (copy from Foundry deployment / project overview).
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR_PROJECT
AZURE_OPENAI_API_KEY=SET_IN_SWA_APP_SETTINGS
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# Classic Azure OpenAI resource also works:
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
