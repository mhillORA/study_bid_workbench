# Copy to .env and fill in (never commit .env)

COSMOS_ENDPOINT=https://YOUR_ACCOUNT.documents.azure.com:443/
COSMOS_KEY=YOUR_PRIMARY_KEY
COSMOS_DATABASE=bd-budgets

# Ora Clinical Intelligence JSON pack (optional local path for ingest script)
# ORA_INTEL_DATA_DIR=_inbox/claude-model-files

# Ask Buddy — set these on Static Web App "bd-budgets" Application settings.
# Foundry project endpoint (BudgetBuddy):
AZURE_OPENAI_ENDPOINT=https://budgetbuddy-resource.services.ai.azure.com/api/projects/budgetbuddy
AZURE_OPENAI_API_KEY=SET_IN_SWA_APP_SETTINGS
# Optional if still using plain chat completions fallback:
AZURE_OPENAI_DEPLOYMENT=gpt-5.4

# Foundry Agent with web search (preferred). Defaults to BudgetBuddy2 when project endpoint is set.
FOUNDRY_AGENT_NAME=BudgetBuddy2
# Or paste the full agent responses URL:
# FOUNDRY_AGENT_ENDPOINT=https://budgetbuddy-resource.services.ai.azure.com/api/projects/budgetbuddy/agents/BudgetBuddy2/endpoint/protocols/openai/responses
# FOUNDRY_AGENT_ENABLED=false   # force classic chat completions instead

# Copilot Studio → same Buddy context (POST /api/copilot/ask with header x-copilot-key)
COPILOT_ASK_KEY=SET_IN_SWA_APP_SETTINGS

# Classic Azure OpenAI resource also works:
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
