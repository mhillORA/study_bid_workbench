# Copy to .env and fill in (never commit .env)

COSMOS_ENDPOINT=https://YOUR_ACCOUNT.documents.azure.com:443/
COSMOS_KEY=YOUR_PRIMARY_KEY
COSMOS_DATABASE=bd-budgets

# Ask page — prefer Azure OpenAI (Copilot-style). Set in SWA Application settings.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=SET_IN_SWA_APP_SETTINGS
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Optional later — Claude fallback if Azure OpenAI is not set
# ANTHROPIC_API_KEY=SET_IN_SWA_APP_SETTINGS
# ANTHROPIC_MODEL=claude-sonnet-4-5
